
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

# Step 1: Load dataset
data = pd.read_csv("Iris.csv")

# Step 2: Select numerical features
X = data[['SepalLengthCm', 'SepalWidthCm',
          'PetalLengthCm', 'PetalWidthCm']]

# Step 3: Scale the features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Step 4: Apply Elbow Method
wcss = []

for k in range(1, 11):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    model.fit(X_scaled)
    wcss.append(model.inertia_)

# Plot Elbow Curve
plt.plot(range(1, 11), wcss, marker='o')
plt.xlabel("Number of Clusters (K)")
plt.ylabel("WCSS")
plt.title("Elbow Method")
plt.show()

# Step 5: Apply K-Means with K = 3
kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)

data['Cluster'] = kmeans.fit_predict(X_scaled)

# Step 6: Display cluster assignments
print(data[['Species', 'Cluster']].head(10))

# Step 7: Visualize clusters
plt.scatter(
    data['PetalLengthCm'],
    data['PetalWidthCm'],
    c=data['Cluster'],
    cmap='viridis'
)

plt.xlabel("Petal Length")
plt.ylabel("Petal Width")
plt.title("K-Means Clustering on Iris Dataset")
plt.show()

# Step 8: Compare clusters with actual species
print("\nCluster vs Species:")
print(pd.crosstab(data['Species'], data['Cluster']))
