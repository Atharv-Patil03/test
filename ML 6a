
import numpy as np
import matplotlib.pyplot as plt
import random

# Step 1: Create maze
maze = np.zeros((5, 5))

# 1 represents a wall
walls = [(1, 1), (1, 3), (2, 3), (3, 1)]

for wall in walls:
    maze[wall] = 1

start = (0, 0)
goal = (4, 4)

# Step 2: Define actions
# 0 = Up, 1 = Down, 2 = Left, 3 = Right

actions = {
    0: (-1, 0),
    1: (1, 0),
    2: (0, -1),
    3: (0, 1)
}

# Step 3: Initialize Q-table
q_table = np.zeros((25, 4))

# Convert maze position into state number
def get_state(position):
    return position[0] * 5 + position[1]

# Step 4: Set learning parameters
learning_rate = 0.1
discount_factor = 0.9
epsilon = 1.0
epsilon_decay = 0.995
min_epsilon = 0.01

episodes = 5000

# Step 5: Train the agent
for episode in range(episodes):

    position = start

    for step in range(100):

        state = get_state(position)

        # Epsilon-greedy action selection
        if random.random() < epsilon:
            action = random.choice(list(actions.keys()))
        else:
            action = np.argmax(q_table[state])

        # Calculate next position
        move = actions[action]

        next_position = (
            position[0] + move[0],
            position[1] + move[1]
        )

        # Check boundaries and walls
        if (
            next_position[0] < 0 or next_position[0] >= 5
            or next_position[1] < 0 or next_position[1] >= 5
            or maze[next_position] == 1
        ):
            next_position = position
            reward = -5

        elif next_position == goal:
            reward = 100

        else:
            reward = -1

        next_state = get_state(next_position)

        # Q-Learning update
        old_value = q_table[state, action]

        next_max = np.max(q_table[next_state])

        new_value = old_value + learning_rate * (
            reward + discount_factor * next_max - old_value
        )

        q_table[state, action] = new_value

        position = next_position

        # Stop if goal is reached
        if position == goal:
            break

    # Reduce exploration over time
    epsilon = max(min_epsilon, epsilon * epsilon_decay)

# Step 6: Display learned path
position = start
path = [position]
visited = {position}

for step in range(50):

    state = get_state(position)
    action = np.argmax(q_table[state])

    move = actions[action]

    next_position = (
        position[0] + move[0],
        position[1] + move[1]
    )

    # Check invalid moves
    if (
        next_position[0] < 0 or next_position[0] >= 5
        or next_position[1] < 0 or next_position[1] >= 5
        or maze[next_position] == 1
    ):
        break

    position = next_position

    if position in visited:
        break

    path.append(position)
    visited.add(position)

    if position == goal:
        break

# Step 7: Print path
print("Learned Path:", path)

if position == goal:
    print("Goal Reached!")
else:
    print("Goal not reached. Try increasing episodes.")

# Step 8: Visualize maze and learned path
display_maze = maze.copy()

for r, c in path:
    display_maze[r, c] = 2

display_maze[start] = 3
display_maze[goal] = 4

plt.imshow(display_maze, cmap='viridis')

plt.title("Q-Learning Maze Navigation")
plt.xticks(range(5))
plt.yticks(range(5))
plt.grid(True)

for r in range(5):
    for c in range(5):
        if (r, c) == start:
            label = "S"
        elif (r, c) == goal:
            label = "G"
        elif maze[r, c] == 1:
            label = "#"
        elif (r, c) in path:
            label = "*"
        else:
            label = ""

        plt.text(c, r, label, ha='center',
                 va='center', color='white')

plt.show()
